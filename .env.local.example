# ─── إعدادات ChatGPT ──────────────────────────────────────
# مطلوب – كوكي الجلسة (يمكنك وضعه لاحقًا من لوحة الإدارة)
CHATGPT_SESSION_COOKIE=""
# اختياري – Access Token (يمكن تركه فارغًا وسيتم التحديث تلقائيًا)
CHATGPT_ACCESS_TOKEN=""

# ─── الأمان ────────────────────────────────────────────────
# مفتاح API لحماية الواجهة العامة (اختياري، يمكن وضعه من لوحة الإدارة)
API_ACCESS_KEY=""

# كلمة مرور صفحة الإدارة (اختياري)
# إذا لم تعيّنها، كلمة المرور الافتراضية هي: admin
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# JWT Secret (مطلوب – يجب تغييره لقيمة عشوائية قوية)
JWT_SECRET="change-me-to-a-random-secret"

# Secret للـ Cron (اختياري – لحماية رابط التحديث التلقائي)
CRON_SECRET=""

# ─── قاعدة البيانات (Redis) ───────────────────────────────
# الخيار الأول (موصى به): أنشئ Upstash Redis من Vercel Storage
# وستُضاف هذه المتغيرات تلقائياً:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# الخيار الثاني: Upstash Redis خارجي
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# الخيار الثالث: أي Redis خارجي (redis:// أو rediss://)
# يمكن أيضاً ضبطه من لوحة الإدارة مباشرة
# أمثلة:
#   redis://default:password@hostname:port
#   rediss://user:pass@host:6380
REDIS_URL=""

# ملاحظة: إذا لم تضبط أي من المتغيرات أعلاه، سيعمل التطبيق بذاكرة مؤقتة
# وستفقد الإعدادات عند إعادة تشغيل الخادم.
