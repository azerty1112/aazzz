# ────────────────────────────────────────────────
#  انسخ هذا الملف إلى .env.local وعدّل القيم
# ────────────────────────────────────────────────

# مفتاح سري لتوقيع JWT (ولّد أي نص طويل عشوائي)
JWT_SECRET=change-me-to-something-long-and-random

# (اختياري) كلمة مرور الإدارة المبدئية - تُستخدم إن لم تُضبط من اللوحة
# ADMIN_PASSWORD=admin

# (اختياري) كوكيز ChatGPT - يمكن ضبطها من لوحة الإدارة بدلاً من هنا
# CHATGPT_SESSION_COOKIE=__Secure-next-auth.session-token.0=xxx; ...

# (اختياري) توكن الوصول - يُحدَّث تلقائياً من الكوكيز
# CHATGPT_ACCESS_TOKEN=

# (اختياري) مفتاح لحماية /api/chat - يُطلب في الهيدر x-api-key
# API_ACCESS_KEY=your-secret-key

# ───────── Supabase (اختياري للحفظ المستمر) ─────────
# أنشئ مشروعاً على supabase.com مجاناً وأنشئ جدول kv كما في SUPABASE_SETUP.md
# SUPABASE_URL=https://xxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ───────── Cron (لتجديد التوكن يومياً) ─────────────
# اضبطها لتستخدمها في Cron Job خارجي (Namecheap cPanel)
# CRON_SECRET=your-cron-secret
